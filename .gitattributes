# Auto detect line endings
* text=auto

# Batch files MUST use CRLF.
# cmd.exe reads .cmd files line by line; LF-only line endings have bitten
# this project before (labels and goto misbehave).
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Shell scripts must stay LF or they break on Unix runners.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets
*.png   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.pdb   binary

# Keep the diff for the manifest and build script honest
*.manifest text
